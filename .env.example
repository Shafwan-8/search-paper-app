# ===========================================
# Konfigurasi API Keys
# Salin file ini menjadi .env dan isi nilainya
# ===========================================

# Port server (default: 5000)
PORT=5000

# OpenAlex API
OPENALEX_API_KEY=

# Contoh API keys lainnya (uncomment jika dibutuhkan)
# SERPAPI_KEY=your_serpapi_key_here
# CORE_API_KEY=your_core_api_key_here
# GOOGLE_SCHOLAR_API_KEY=your_google_scholar_key_here
